# Rust / Tauri build output — regenerated by every build, never committed
/src-tauri/target/
/src-tauri/gen/
**/*.rs.bk

# Generated mobile projects (recreated by `cargo tauri ios init`)
/src-tauri/gen/apple/
/src-tauri/gen/android/

# Build artefacts
*.msi
*.exe
*.dmg
*.app
*.ipa
*.AppImage
*.deb

# Node, if a tooling dependency is ever added
node_modules/
package-lock.json

# Editors and operating systems
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Signing material — never commit these, use GitHub Secrets
*.p12
*.mobileprovision
*.cer
*.certSigningRequest
.env
.env.local

# Local test output
docs/tests/__pycache__/
docs/tests/*.png
