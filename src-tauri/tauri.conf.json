{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "APEX",
  "mainBinaryName": "APEX",
  "version": "5.0.0",
  "identifier": "com.apex.commandcentre",
  "build": {
    "frontendDist": "../src",
    "devUrl": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "APEX",
        "width": 1440,
        "height": 920,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#090D16",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; media-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "APEX Command Centre",
    "longDescription": "APEX is a personal productivity command centre: study logging and analytics, a focus timer, tasks, habits, fitness, a day planner, an XP and level progression system and an interactive Emirates Stadium illustration. All data is stored locally on the device.",
    "copyright": "APEX",
    "publisher": "APEX",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "language": ["en-US"]
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "iOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
